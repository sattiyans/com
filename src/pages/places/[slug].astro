---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import PlaceRating from "@components/PlaceRating.astro";
import FormattedDate from "@components/FormattedDate.astro";
import PlacesMap from "@components/PlacesMap.astro";
import { getCheckins, getPlaceBySlug } from "@lib/places/db";
import { btnSecondary, sectionLabel } from "@lib/places/ui";

export const prerender = false;

const place = await getPlaceBySlug(Astro.params.slug ?? "");
if (!place) return new Response(null, { status: 404 });

const checkins = await getCheckins(place.id); // newest first
// Places whose check-ins were all deleted are hidden from the index; don't serve a thin page either.
if (checkins.length === 0) return new Response(null, { status: 404 });
const avg = checkins.length ? checkins.reduce((n, c) => n + c.rating, 0) / checkins.length : null;

const chronological = [...checkins].reverse();
const first = chronological[0];
const latest = checkins[0];
const best = checkins.length ? Math.max(...checkins.map((c) => c.rating)) : null;

// Change vs the visit before it, keyed by check-in id.
const delta = new Map<number, number>();
chronological.forEach((c, i) => {
  if (i > 0) delta.set(c.id, c.rating - chronological[i - 1].rating);
});

// Ratings plotted 1–5 bottom-to-top, visits spread evenly left-to-right (inset so dots aren't clipped).
const chartPoints = chronological.map((c, i) => ({
  n: i + 1,
  rating: c.rating,
  latest: c.id === latest?.id,
  x: chronological.length === 1 ? 50 : 4 + (i / (chronological.length - 1)) * 92,
  y: ((5 - c.rating) / 4) * 100,
}));

const trend =
  checkins.length > 1 && latest && first
    ? latest.rating > first.rating
      ? "Getting better"
      : latest.rating < first.rating
        ? "Slipping"
        : "Consistent"
    : null;

// SEO: dynamic title/description, OG image (cache-busted by visit count + last visit) and JSON-LD.
const clip = (text: string, max: number) => (text.length > max ? `${text.slice(0, max - 1).trimEnd()}…` : text);
const visitsLabel = `${checkins.length} ${checkins.length === 1 ? "visit" : "visits"}`;
const seoTitle = avg !== null ? `${place.name} — Rated ${avg.toFixed(1)}/5` : `${place.name} — Places`;
const seoDescription = clip(
  [
    avg !== null
      ? `${place.name}, rated ${avg.toFixed(1)}/5 over ${visitsLabel}.`
      : `${place.name}: check-ins and notes.`,
    latest?.review ? `Latest: “${latest.review.replace(/\s+/g, " ").trim()}”` : null,
  ]
    .filter(Boolean)
    .join(" "),
  160,
);
const ogVersion = `r2-${checkins.length}-${latest ? new Date(latest.visited_at).getTime() : 0}`;
const ogImage = `/places/${place.slug}/og.png?v=${ogVersion}`;
const pageUrl = new URL(`/places/${place.slug}`, Astro.site ?? Astro.url).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Place",
      "@id": `${pageUrl}#place`,
      name: place.name,
      url: pageUrl,
      hasMap: place.maps_url,
      ...(place.lat !== null && place.lng !== null
        ? { geo: { "@type": "GeoCoordinates", latitude: place.lat, longitude: place.lng } }
        : {}),
      review: checkins.map((c) => ({
        "@type": "Review",
        datePublished: new Date(c.visited_at).toISOString().slice(0, 10),
        reviewBody: c.review || undefined,
        reviewRating: { "@type": "Rating", ratingValue: c.rating, bestRating: 5, worstRating: 1 },
        author: { "@type": "Person", name: "Sattiyan Selvarajah", url: "https://sattiyans.com" },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://sattiyans.com/" },
        { "@type": "ListItem", position: 2, name: "Places", item: "https://sattiyans.com/places" },
        { "@type": "ListItem", position: 3, name: place.name, item: pageUrl },
      ],
    },
  ],
};
---

<PageLayout
  title={seoTitle}
  description={seoDescription}
  keywords={`${place.name}, ${place.name} review, ${place.name} rating, sattiyan places`}
  image={ogImage}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <Container>
    <div class="space-y-10">
      <nav class="flex items-center space-x-2 text-sm text-black/50 dark:text-white/50">
        <Link href="/" underline={false} class="hover:text-black dark:hover:text-white transition-colors">Home</Link>
        <span>/</span>
        <Link href="/places" underline={false} class="hover:text-black dark:hover:text-white transition-colors">Places</Link>
        <span>/</span>
        <span class="text-black dark:text-white font-medium truncate">{place.name}</span>
      </nav>

      <div class="grid gap-10 lg:grid-cols-[1fr_minmax(280px,340px)] lg:gap-14 items-start">
        <div class="min-w-0 space-y-10">
          <header class="space-y-4">
            <h1 class="animate text-2xl sm:text-3xl font-semibold text-black dark:text-white tracking-tight">
              {place.name}
            </h1>
            <div class="animate flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-black/55 dark:text-white/55">
              {
                avg !== null && (
                  <span class="inline-flex items-center gap-1.5">
                    <PlaceRating rating={avg} class="[&_svg]:size-4" />
                    <span class="font-semibold text-black dark:text-white tabular-nums">{avg.toFixed(1)}</span>
                  </span>
                )
              }
              <span>
                {checkins.length} {checkins.length === 1 ? "visit" : "visits"}
              </span>
              {
                trend && (
                  <span class="rounded-full border border-black/15 dark:border-white/20 px-2.5 py-0.5 text-xs font-semibold text-black dark:text-white">
                    {trend}
                  </span>
                )
              }
            </div>
          </header>

          {
            chronological.length > 1 && (
              <section class="animate space-y-3">
                <h2 class={sectionLabel}>Rating by visit</h2>
                <div class="rounded-2xl border border-black/15 dark:border-white/15 px-5 pt-5 pb-3">
                  <div class="relative h-24">
                    {[5, 3, 1].map((r) => (
                      <div class="absolute inset-x-0 border-t border-dashed border-black/10 dark:border-white/10" style={`top: ${((5 - r) / 4) * 100}%`}>
                        <span class="absolute -left-1 -translate-x-full -translate-y-1/2 text-[10px] tabular-nums text-black/35 dark:text-white/35">{r}</span>
                      </div>
                    ))}
                    <svg class="absolute inset-0 size-full overflow-visible" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                      <polyline
                        points={chartPoints.map((p) => `${p.x},${p.y}`).join(" ")}
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        vector-effect="non-scaling-stroke"
                        class="text-amber-400"
                      />
                    </svg>
                    {chartPoints.map((p) => (
                      <span
                        class:list={[
                          "absolute size-3 -translate-x-1/2 -translate-y-1/2 rounded-full ring-2 ring-stone-100 dark:ring-black",
                          p.latest ? "bg-amber-400" : "bg-amber-400/60",
                        ]}
                        style={`left: ${p.x}%; top: ${p.y}%`}
                        title={`Visit ${p.n}: ${p.rating}/5`}
                      />
                    ))}
                  </div>
                  <div class="relative mt-3 h-4">
                    {chartPoints.map((p) => (
                      <span class="absolute -translate-x-1/2 text-[10px] tabular-nums text-black/45 dark:text-white/45" style={`left: ${p.x}%`}>
                        V{p.n}
                      </span>
                    ))}
                  </div>
                </div>
              </section>
            )
          }

          <section class="animate space-y-3">
            <h2 class={sectionLabel}>Visits</h2>
            <ol class="space-y-3">
              {
                checkins.map((checkin, i) => {
                  const change = delta.get(checkin.id);
                  return (
                    <li class="rounded-2xl border border-black/15 dark:border-white/15 p-5 space-y-3">
                      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                        <span class="text-sm font-semibold text-black dark:text-white">Visit {checkins.length - i}</span>
                        <span class="text-xs text-black/45 dark:text-white/45">
                          <FormattedDate date={new Date(checkin.visited_at)} />
                        </span>
                        <PlaceRating rating={checkin.rating} />
                        {change !== undefined && change !== 0 && (
                          <span
                            class:list={[
                              "rounded-full px-2 py-0.5 text-[11px] font-semibold tabular-nums",
                              change > 0
                                ? "bg-green-500/10 text-green-700 dark:text-green-400"
                                : "bg-red-500/10 text-red-700 dark:text-red-400",
                            ]}
                          >
                            {change > 0 ? `▲ +${change}` : `▼ ${change}`}
                          </span>
                        )}
                      </div>
                      {checkin.review ? (
                        <p class="text-sm text-black/75 dark:text-white/75 leading-relaxed whitespace-pre-line">
                          {checkin.review}
                        </p>
                      ) : (
                        <p class="text-sm italic text-black/40 dark:text-white/40">No notes this time.</p>
                      )}
                    </li>
                  );
                })
              }
            </ol>
          </section>
        </div>

        <aside class="animate lg:sticky lg:top-28 space-y-6">
          {
            place.lat !== null && place.lng !== null && (
              <PlacesMap
                pins={[{ name: place.name, slug: place.slug, lat: place.lat, lng: place.lng, rating: avg, visits: checkins.length }]}
                class="h-56 lg:h-64"
              />
            )
          }

          <dl class="grid grid-cols-2 rounded-2xl border border-black/15 dark:border-white/15">
            <div class="border-b border-r border-black/10 dark:border-white/10 px-4 py-3">
              <dt class="text-[11px] text-black/45 dark:text-white/45">Average</dt>
              <dd class="text-lg font-semibold text-black dark:text-white tabular-nums">{avg !== null ? avg.toFixed(1) : "–"}</dd>
            </div>
            <div class="border-b border-black/10 dark:border-white/10 px-4 py-3">
              <dt class="text-[11px] text-black/45 dark:text-white/45">Best</dt>
              <dd class="text-lg font-semibold text-black dark:text-white tabular-nums">{best ?? "–"}<span class="text-xs font-normal text-black/45 dark:text-white/45">/5</span></dd>
            </div>
            <div class="border-r border-black/10 dark:border-white/10 px-4 py-3">
              <dt class="text-[11px] text-black/45 dark:text-white/45">First visit</dt>
              <dd class="text-sm font-medium text-black dark:text-white">
                {first ? <FormattedDate date={new Date(first.visited_at)} /> : "–"}
              </dd>
            </div>
            <div class="px-4 py-3">
              <dt class="text-[11px] text-black/45 dark:text-white/45">Last visit</dt>
              <dd class="text-sm font-medium text-black dark:text-white">
                {latest ? <FormattedDate date={new Date(latest.visited_at)} /> : "–"}
              </dd>
            </div>
          </dl>

          <div class="flex flex-col gap-3">
            <a href={place.maps_url} target="_blank" rel="noopener" class:list={[btnSecondary, "w-full"]}>
              Open in Google Maps ↗
            </a>
            <a data-astro-reload href="/places" class="text-center text-sm underline underline-offset-2 decoration-black/15 dark:decoration-white/30 hover:text-black dark:hover:text-white">
              ← All places
            </a>
          </div>
        </aside>
      </div>
    </div>
  </Container>
</PageLayout>

