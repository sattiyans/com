---
import ToolShell from "@components/ToolShell.astro";
import { getTool } from "@data/tools";

const tool = getTool("lhdn-tax-relief")!;

const reliefs = [
  { id: "individual", label: "Individual relief", cap: 9000, default: 9000, hint: "Fixed personal relief" },
  { id: "epf", label: "EPF / approved pension", cap: 4000, default: 4000, hint: "Employee EPF (max RM4,000)" },
  { id: "lifestyle", label: "Lifestyle", cap: 2500, default: 0, hint: "Books, PC, internet, self-education" },
  { id: "sports", label: "Sports equipment / activities", cap: 1000, default: 0, hint: "Sports gear & gym (YA rules)" },
  { id: "medical", label: "Medical (self / family)", cap: 10000, default: 0, hint: "Serious disease, fertility, dental, etc." },
  { id: "sspn", label: "SSPN / SSPN Prime", cap: 8000, default: 0, hint: "Net savings in SSPN (max RM8,000)" },
  { id: "prs", label: "PRS / deferred annuity", cap: 3000, default: 0, hint: "Private retirement scheme" },
];
---

<ToolShell tool={tool}>
  <div class="space-y-8">
    <div class="space-y-2">
      <label for="income" class="block text-sm font-medium text-black dark:text-white">
        Annual chargeable income (before reliefs), RM
      </label>
      <input
        id="income"
        type="number"
        min="0"
        step="100"
        value="80000"
        class="w-full px-0 py-2.5 bg-transparent border-0 border-b border-black/20 dark:border-white/25 text-black dark:text-white focus:outline-none focus:border-black dark:focus:border-white"
      />
    </div>

    <div class="space-y-3">
      <h3 class="text-xs font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">Reliefs</h3>
      <ul
        class="divide-y divide-black/10 dark:divide-white/10 border-t border-b border-black/10 dark:border-white/10"
        id="relief-list"
      >
        {
          reliefs.map((r) => (
            <li
              class="py-4 flex flex-col sm:flex-row sm:items-center gap-3"
              data-relief={r.id}
              data-cap={r.cap}
            >
              <label class="flex items-start gap-3 flex-1 cursor-pointer">
                <input
                  type="checkbox"
                  class="relief-toggle mt-1 rounded border-black/20"
                  data-id={r.id}
                  checked={r.default > 0}
                />
                <span>
                  <span class="block text-sm font-medium text-black dark:text-white">{r.label}</span>
                  <span class="block text-xs text-black/45 dark:text-white/45 mt-0.5">
                    Cap RM{r.cap.toLocaleString()} · {r.hint}
                  </span>
                </span>
              </label>
              <input
                type="number"
                class="relief-amount w-full sm:w-28 px-0 py-1.5 bg-transparent border-0 border-b border-black/20 dark:border-white/25 text-sm text-black dark:text-white focus:outline-none focus:border-black dark:focus:border-white"
                data-id={r.id}
                min="0"
                max={r.cap}
                value={r.default}
                disabled={r.default === 0}
              />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="grid sm:grid-cols-3 gap-6 pt-2" id="tax-results">
      <div>
        <p class="text-[11px] uppercase tracking-wide text-black/45 dark:text-white/45">Tax without reliefs</p>
        <p class="mt-1 text-lg font-semibold text-black dark:text-white" id="tax-gross">—</p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-wide text-black/45 dark:text-white/45">Tax after reliefs</p>
        <p class="mt-1 text-lg font-semibold text-black dark:text-white" id="tax-net">—</p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-wide text-black/45 dark:text-white/45">Estimated saved</p>
        <p class="mt-1 text-lg font-semibold text-black dark:text-white" id="tax-saved">—</p>
      </div>
    </div>

    <p class="text-xs text-black/40 dark:text-white/40" id="tax-note"></p>
  </div>

  <script is:inline>
    (function () {
      const brackets = [
        { upTo: 5000, rate: 0 },
        { upTo: 20000, rate: 0.01 },
        { upTo: 35000, rate: 0.03 },
        { upTo: 50000, rate: 0.06 },
        { upTo: 70000, rate: 0.11 },
        { upTo: 100000, rate: 0.19 },
        { upTo: 250000, rate: 0.25 },
        { upTo: 400000, rate: 0.26 },
        { upTo: 600000, rate: 0.28 },
        { upTo: 1000000, rate: 0.28 },
        { upTo: Infinity, rate: 0.3 },
      ];

      function calcTax(income) {
        let remaining = Math.max(0, income);
        let prev = 0;
        let tax = 0;
        for (const b of brackets) {
          const span = Math.min(remaining, b.upTo - prev);
          if (span <= 0) break;
          tax += span * b.rate;
          remaining -= span;
          prev = b.upTo;
          if (remaining <= 0) break;
        }
        return tax;
      }

      function rm(n) {
        return "RM " + Math.round(n).toLocaleString("en-MY");
      }

      function recalc() {
        const income = Number(document.getElementById("income").value) || 0;
        let reliefTotal = 0;
        document.querySelectorAll("[data-relief]").forEach((row) => {
          const id = row.dataset.relief;
          const toggle = row.querySelector('.relief-toggle[data-id="' + id + '"]');
          const amount = row.querySelector('.relief-amount[data-id="' + id + '"]');
          const cap = Number(row.dataset.cap);
          amount.disabled = !toggle.checked;
          if (toggle.checked) {
            let v = Math.min(cap, Math.max(0, Number(amount.value) || 0));
            amount.value = v;
            reliefTotal += v;
          }
        });
        const chargeable = Math.max(0, income - reliefTotal);
        const gross = calcTax(income);
        const net = calcTax(chargeable);
        const saved = Math.max(0, gross - net);
        document.getElementById("tax-gross").textContent = rm(gross);
        document.getElementById("tax-net").textContent = rm(net);
        document.getElementById("tax-saved").textContent = rm(saved);
        document.getElementById("tax-note").textContent =
          "Reliefs claimed: " +
          rm(reliefTotal) +
          " · Chargeable after reliefs: " +
          rm(chargeable) +
          (saved > 0
            ? " · Tip: unclaimed lifestyle / SSPN / PRS often leave money on the table."
            : "");
      }

      document.getElementById("income").addEventListener("input", recalc);
      document.querySelectorAll(".relief-toggle, .relief-amount").forEach((el) => {
        el.addEventListener("change", recalc);
        el.addEventListener("input", recalc);
      });
      recalc();
    })();
  </script>
</ToolShell>
