---
import ToolShell from "@components/ToolShell.astro";
import { getTool } from "@data/tools";

const tool = getTool("cron-parser")!;
---

<ToolShell tool={tool}>
  <div class="space-y-8">
    <div class="space-y-3">
      <label for="cron-input" class="block text-sm font-medium text-black dark:text-white">Cron expression</label>
      <input
        id="cron-input"
        type="text"
        value="*/15 * * * *"
        spellcheck="false"
        class="w-full px-0 py-2.5 bg-transparent border-0 border-b border-black/20 dark:border-white/25 font-mono text-sm text-black dark:text-white focus:outline-none focus:border-black dark:focus:border-white"
      />
      <div class="flex flex-wrap gap-x-4 gap-y-1">
        {
          ["0 9 * * 1-5", "0 0 1 * *", "30 2 */2 * *", "0 */6 * * *"].map((ex) => (
            <button
              type="button"
              class="cron-example text-xs font-mono text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white underline-offset-2 hover:underline"
              data-cron={ex}
            >
              {ex}
            </button>
          ))
        }
      </div>
    </div>

    <div class="space-y-2">
      <h3 class="text-xs font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">Meaning</h3>
      <p id="cron-human" class="text-sm text-black dark:text-white leading-relaxed">—</p>
      <p id="cron-error" class="hidden text-sm text-red-600 dark:text-red-400"></p>
    </div>

    <div class="space-y-2">
      <h3 class="text-xs font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">Next 10 runs (local time)</h3>
      <ol
        id="cron-next"
        class="divide-y divide-black/10 dark:divide-white/10 border-t border-b border-black/10 dark:border-white/10 text-sm"
      ></ol>
    </div>
  </div>

  <script is:inline>
    (function () {
      const input = document.getElementById("cron-input");
      const human = document.getElementById("cron-human");
      const err = document.getElementById("cron-error");
      const list = document.getElementById("cron-next");

      function expandField(field, min, max) {
        const values = new Set();
        for (const part of field.split(",")) {
          if (part === "*") {
            for (let i = min; i <= max; i++) values.add(i);
            continue;
          }
          const stepMatch = part.match(/^(\*|\d+)(?:-(\d+))?\/(\d+)$/);
          if (stepMatch) {
            const start = stepMatch[1] === "*" ? min : Number(stepMatch[1]);
            const end = stepMatch[2] ? Number(stepMatch[2]) : max;
            const step = Number(stepMatch[3]);
            for (let i = start; i <= end; i += step) values.add(i);
            continue;
          }
          const range = part.match(/^(\d+)-(\d+)$/);
          if (range) {
            for (let i = Number(range[1]); i <= Number(range[2]); i++) values.add(i);
            continue;
          }
          if (/^\d+$/.test(part)) {
            values.add(Number(part));
            continue;
          }
          throw new Error("Invalid field: " + part);
        }
        return [...values].filter((v) => v >= min && v <= max).sort((a, b) => a - b);
      }

      function describe(field, labels) {
        if (field === "*") return "every " + labels.unit;
        if (field.startsWith("*/")) return "every " + field.slice(2) + " " + labels.unit + "s";
        return labels.unit + " " + field;
      }

      function parseCron(expr) {
        const cleaned = expr.trim().replace(/\s+/g, " ");
        // strip optional seconds / year for quartz-ish: take last 5 of 5–6–7
        let parts = cleaned.split(" ");
        if (parts.length === 6 || parts.length === 7) {
          // drop seconds (first) if 6+, keep 5 standard
          parts = parts.length === 7 ? parts.slice(1, 6) : parts.slice(1);
        }
        if (parts.length !== 5) throw new Error("Expected 5 fields: minute hour day month weekday");
        const [minute, hour, day, month, weekday] = parts;
        return {
          minute: expandField(minute, 0, 59),
          hour: expandField(hour, 0, 23),
          day: expandField(day, 1, 31),
          month: expandField(month, 1, 12),
          weekday: expandField(weekday, 0, 7).map((d) => (d === 7 ? 0 : d)),
          raw: { minute, hour, day, month, weekday },
        };
      }

      function matches(date, cron) {
        const dow = date.getDay();
        const dayOk = cron.raw.day === "*" || cron.day.includes(date.getDate());
        const dowOk = cron.raw.weekday === "*" || cron.weekday.includes(dow);
        // if both day and weekday restricted, cron OR semantics
        const domDow =
          cron.raw.day === "*" || cron.raw.weekday === "*"
            ? dayOk && dowOk
            : dayOk || dowOk;
        return (
          cron.minute.includes(date.getMinutes()) &&
          cron.hour.includes(date.getHours()) &&
          cron.month.includes(date.getMonth() + 1) &&
          domDow
        );
      }

      function nextRuns(cron, count) {
        const results = [];
        const d = new Date();
        d.setSeconds(0, 0);
        d.setMinutes(d.getMinutes() + 1);
        let guard = 0;
        while (results.length < count && guard < 366 * 24 * 60) {
          if (matches(d, cron)) results.push(new Date(d));
          d.setMinutes(d.getMinutes() + 1);
          guard++;
        }
        return results;
      }

      function humanize(cron) {
        const r = cron.raw;
        return [
          describe(r.minute, { unit: "minute" }),
          describe(r.hour, { unit: "hour" }),
          r.day === "*" ? "every day-of-month" : "day " + r.day,
          r.month === "*" ? "every month" : "month " + r.month,
          r.weekday === "*" ? "every weekday" : "weekday " + r.weekday + " (0=Sun)",
        ].join(" · ");
      }

      function render() {
        try {
          const cron = parseCron(input.value);
          err.classList.add("hidden");
          human.textContent = humanize(cron);
          list.innerHTML = "";
          nextRuns(cron, 10).forEach((dt, i) => {
            const li = document.createElement("li");
            li.className = "flex gap-3 py-2.5 text-black dark:text-white";
            li.innerHTML =
              '<span class="text-black/35 dark:text-white/35 w-6">' +
              (i + 1) +
              '</span><span class="font-mono text-xs sm:text-sm">' +
              dt.toLocaleString(undefined, {
                weekday: "short",
                year: "numeric",
                month: "short",
                day: "numeric",
                hour: "2-digit",
                minute: "2-digit",
              }) +
              "</span>";
            list.appendChild(li);
          });
        } catch (e) {
          human.textContent = "—";
          list.innerHTML = "";
          err.textContent = e.message;
          err.classList.remove("hidden");
        }
      }

      input.addEventListener("input", render);
      document.querySelectorAll(".cron-example").forEach((btn) => {
        btn.addEventListener("click", () => {
          input.value = btn.dataset.cron;
          render();
        });
      });
      render();
    })();
  </script>
</ToolShell>
