---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import { TOOLS } from "@data/tools";
import { TOOLS_PAGE } from "@consts";

const seoData = {
  title: TOOLS_PAGE.TITLE!,
  description: TOOLS_PAGE.DESCRIPTION,
  keywords: TOOLS_PAGE.KEYWORDS,
};

const categories = [...new Set(TOOLS.map((t) => t.category))];

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Free Online Developer & Utility Tools",
  description: seoData.description,
  url: "https://sattiyans.com/tools",
  isPartOf: {
    "@type": "WebSite",
    name: "Sattiyan Selvarajah",
    url: "https://sattiyans.com",
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: TOOLS.length,
    itemListElement: TOOLS.map((tool, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: tool.shortName,
      url: `https://sattiyans.com${tool.href}`,
      description: tool.description,
    })),
  },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://sattiyans.com/" },
    { "@type": "ListItem", position: 2, name: "Tools", item: "https://sattiyans.com/tools" },
  ],
};
---

<PageLayout title={seoData.title} description={seoData.description} keywords={seoData.keywords} image="/og-image.png">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <Container>
    <div class="space-y-10">
      <nav aria-label="Breadcrumb" class="flex items-center space-x-2 text-sm text-black/50 dark:text-white/50">
        <Link href="/" underline={false} class="hover:text-black dark:hover:text-white transition-colors">Home</Link>
        <span aria-hidden="true">/</span>
        <span class="text-black dark:text-white font-medium">Tools</span>
      </nav>

      <div class="grid gap-10 lg:grid-cols-[1fr_minmax(240px,300px)] lg:gap-14 items-start">
        <div class="min-w-0 space-y-8">
          <header class="space-y-3">
            <h1 class="text-2xl sm:text-3xl font-semibold text-black dark:text-white tracking-tight">
              Free online tools
            </h1>
            <p class="text-sm sm:text-base text-black/65 dark:text-white/65 leading-relaxed max-w-xl">
              Malaysia tax relief, EXIF/GPS strip, cron schedules, SVG cleanup, and cookie debugging —
              all 100% in your browser.
            </p>
          </header>

          <ul class="divide-y divide-black/10 dark:divide-white/10 border-t border-b border-black/10 dark:border-white/10">
            {
              TOOLS.map((tool) => (
                <li>
                  <Link
                    href={tool.href}
                    underline={false}
                    class="group flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-8 py-6 no-underline hover:bg-black/[0.02] dark:hover:bg-white/[0.03] -mx-2 px-2 transition-colors"
                  >
                    <span class="shrink-0 text-xs uppercase tracking-wide text-black/45 dark:text-white/45 sm:w-24">
                      {tool.category}
                    </span>
                    <span class="min-w-0 flex-1 space-y-1.5">
                      <span class="block text-base font-semibold text-black dark:text-white group-hover:opacity-80 transition-opacity">
                        {tool.shortName}
                      </span>
                      <span class="block text-sm text-black/60 dark:text-white/60 leading-relaxed line-clamp-2">
                        {tool.description}
                      </span>
                      <span class="block text-xs text-black/40 dark:text-white/40">
                        {tool.primaryKeyword}
                        <span class="ml-2 opacity-0 group-hover:opacity-100 transition-opacity">Open →</span>
                      </span>
                    </span>
                  </Link>
                </li>
              ))
            }
          </ul>

          <section class="space-y-3" aria-labelledby="why-tools">
            <h2 id="why-tools" class="text-lg font-semibold text-black dark:text-white">
              Why these tools stay in the browser
            </h2>
            <p class="text-sm text-black/60 dark:text-white/60 leading-relaxed max-w-xl">
              Tax numbers, photos with GPS, cookies, and production cron strings are sensitive. Each tool
              is a static page with client-side JavaScript — your inputs never hit a backend.
            </p>
          </section>
        </div>

        <aside class="lg:sticky lg:top-28 space-y-8">
          <div class="space-y-3">
            <p class="text-[11px] font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">
              At a glance
            </p>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <p class="text-lg font-semibold text-black dark:text-white">{TOOLS.length}</p>
                <p class="text-[11px] text-black/45 dark:text-white/45">tools</p>
              </div>
              <div>
                <p class="text-lg font-semibold text-black dark:text-white">{categories.length}</p>
                <p class="text-[11px] text-black/45 dark:text-white/45">categories</p>
              </div>
            </div>
          </div>

          <div class="space-y-3">
            <p class="text-[11px] font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">
              Categories
            </p>
            <ul class="space-y-2">
              {
                categories.map((cat) => (
                  <li class="text-sm text-black/70 dark:text-white/70 border-b border-black/8 dark:border-white/8 pb-2 last:border-0 last:pb-0">
                    {cat}
                    <span class="text-black/40 dark:text-white/40">
                      {" "}· {TOOLS.filter((t) => t.category === cat).length}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>

          <p class="text-xs text-black/40 dark:text-white/40 leading-relaxed">
            Need a custom internal tool?{" "}
            <Link href="/hire" underline={false} class="underline underline-offset-2 hover:text-black dark:hover:text-white">
              Hire me
            </Link>
          </p>
        </aside>
      </div>
    </div>
  </Container>
</PageLayout>
