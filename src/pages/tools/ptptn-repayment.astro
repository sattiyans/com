---
import ToolShell from "@components/ToolShell.astro";
import { getTool } from "@data/tools";

const tool = getTool("ptptn-repayment")!;
const field =
  "w-full px-0 py-2.5 bg-transparent border-0 border-b border-black/20 dark:border-white/25 text-black dark:text-white focus:outline-none focus:border-black dark:focus:border-white";
---

<ToolShell tool={tool}>
  <div class="space-y-8">
    <div class="grid sm:grid-cols-2 gap-6">
      <div class="space-y-2">
        <label for="balance" class="block text-sm font-medium text-black dark:text-white">
          Outstanding balance (RM)
        </label>
        <input id="balance" type="number" min="0" step="100" value="35000" class={field} />
      </div>
      <div class="space-y-2">
        <label for="years" class="block text-sm font-medium text-black dark:text-white">Repayment years</label>
        <input id="years" type="number" min="1" max="20" step="1" value="10" class={field} />
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      <div class="space-y-2">
        <label for="settle-disc" class="block text-sm font-medium text-black dark:text-white">
          Full settlement discount (%)
        </label>
        <input id="settle-disc" type="number" min="0" max="50" step="1" value="10" class={field} />
        <p class="text-xs text-black/40 dark:text-white/40">Use the % from a current PTPTN campaign.</p>
      </div>
      <div class="space-y-2">
        <label for="dd-disc" class="block text-sm font-medium text-black dark:text-white">
          Direct debit / salary deduction discount (%)
        </label>
        <input id="dd-disc" type="number" min="0" max="20" step="0.5" value="1" class={field} />
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 pt-2">
      <div>
        <p class="text-[11px] uppercase tracking-wide text-black/45 dark:text-white/45">Ujrah (~1%/yr)</p>
        <p class="mt-1 text-lg font-semibold text-black dark:text-white" id="out-ujrah">—</p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-wide text-black/45 dark:text-white/45">Monthly instalment</p>
        <p class="mt-1 text-lg font-semibold text-black dark:text-white" id="out-month">—</p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-wide text-black/45 dark:text-white/45">Full settle (w/ discount)</p>
        <p class="mt-1 text-lg font-semibold text-black dark:text-white" id="out-settle">—</p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-wide text-black/45 dark:text-white/45">Est. discount saved</p>
        <p class="mt-1 text-lg font-semibold text-black dark:text-white" id="out-saved">—</p>
      </div>
    </div>

    <ul class="divide-y divide-black/10 dark:divide-white/10 border-t border-b border-black/10 dark:border-white/10 text-sm">
      <li class="flex justify-between gap-4 py-2.5">
        <span class="text-black/50 dark:text-white/50">Total if paying monthly (w/ ujrah)</span>
        <span class="text-black dark:text-white" id="out-total">—</span>
      </li>
      <li class="flex justify-between gap-4 py-2.5">
        <span class="text-black/50 dark:text-white/50">Monthly with DD discount</span>
        <span class="text-black dark:text-white" id="out-dd">—</span>
      </li>
    </ul>
    <p class="text-xs text-black/40 dark:text-white/40">
      Educational model only — confirm balances and promotions on official PTPTN channels.
    </p>
  </div>

  <script is:inline>
    (function () {
      const rm = (n) => "RM " + Math.round(n).toLocaleString("en-MY");

      function recalc() {
        const P = Math.max(0, Number(document.getElementById("balance").value) || 0);
        const years = Math.max(1, Number(document.getElementById("years").value) || 1);
        const settlePct = Math.max(0, Number(document.getElementById("settle-disc").value) || 0) / 100;
        const ddPct = Math.max(0, Number(document.getElementById("dd-disc").value) || 0) / 100;

        const ujrah = P * 0.01 * years;
        const total = P + ujrah;
        const months = years * 12;
        const monthly = months > 0 ? total / months : 0;
        const settle = P * (1 - settlePct);
        const saved = P - settle;
        const monthlyDd = monthly * (1 - ddPct);

        document.getElementById("out-ujrah").textContent = rm(ujrah);
        document.getElementById("out-month").textContent = rm(monthly);
        document.getElementById("out-settle").textContent = rm(settle);
        document.getElementById("out-saved").textContent = rm(saved);
        document.getElementById("out-total").textContent = rm(total);
        document.getElementById("out-dd").textContent = rm(monthlyDd);
      }

      ["balance", "years", "settle-disc", "dd-disc"].forEach((id) => {
        document.getElementById(id).addEventListener("input", recalc);
      });
      recalc();
    })();
  </script>
</ToolShell>
