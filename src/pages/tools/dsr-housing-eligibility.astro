---
import ToolShell from "@components/ToolShell.astro";
import { getTool } from "@data/tools";

const tool = getTool("dsr-housing-eligibility")!;
const field =
  "w-full px-0 py-2.5 bg-transparent border-0 border-b border-black/20 dark:border-white/25 text-black dark:text-white focus:outline-none focus:border-black dark:focus:border-white";
---

<ToolShell tool={tool}>
  <div class="space-y-8">
    <div class="grid sm:grid-cols-2 gap-6">
      <div class="space-y-2">
        <label for="income" class="block text-sm font-medium text-black dark:text-white">Net monthly income (RM)</label>
        <input id="income" type="number" min="0" step="100" value="6500" class={field} />
      </div>
      <div class="space-y-2">
        <label for="commit" class="block text-sm font-medium text-black dark:text-white">
          Other monthly commitments (RM)
        </label>
        <input id="commit" type="number" min="0" step="50" value="1200" class={field} />
        <p class="text-xs text-black/40 dark:text-white/40">Car loan, PTPTN, card minimums, personal loans, etc.</p>
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-xs font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">Housing instalment</h3>
      <div class="flex flex-wrap gap-4">
        <label class="inline-flex items-center gap-2 text-sm text-black dark:text-white cursor-pointer">
          <input type="radio" name="mode" value="manual" checked />
          Enter instalment
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-black dark:text-white cursor-pointer">
          <input type="radio" name="mode" value="estimate" />
          Estimate from loan
        </label>
      </div>

      <div id="manual-wrap" class="space-y-2">
        <label for="instalment" class="block text-sm font-medium text-black dark:text-white">Proposed housing instalment (RM)</label>
        <input id="instalment" type="number" min="0" step="50" value="2800" class={field} />
      </div>

      <div id="estimate-wrap" class="hidden grid sm:grid-cols-3 gap-6">
        <div class="space-y-2">
          <label for="loan" class="block text-sm font-medium text-black dark:text-white">Loan amount (RM)</label>
          <input id="loan" type="number" min="0" step="1000" value="500000" class={field} />
        </div>
        <div class="space-y-2">
          <label for="rate" class="block text-sm font-medium text-black dark:text-white">Interest % / year</label>
          <input id="rate" type="number" min="0" step="0.05" value="4.2" class={field} />
        </div>
        <div class="space-y-2">
          <label for="years" class="block text-sm font-medium text-black dark:text-white">Tenure (years)</label>
          <input id="years" type="number" min="1" max="35" step="1" value="30" class={field} />
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-3 gap-6 pt-2">
      <div>
        <p class="text-[11px] uppercase tracking-wide text-black/45 dark:text-white/45">Housing instalment</p>
        <p class="mt-1 text-lg font-semibold text-black dark:text-white" id="out-house">—</p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-wide text-black/45 dark:text-white/45">Your DSR</p>
        <p class="mt-1 text-lg font-semibold text-black dark:text-white" id="out-dsr">—</p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-wide text-black/45 dark:text-white/45">Max housing @ 70% DSR</p>
        <p class="mt-1 text-lg font-semibold text-black dark:text-white" id="out-max">—</p>
      </div>
    </div>

    <ul class="divide-y divide-black/10 dark:divide-white/10 border-t border-b border-black/10 dark:border-white/10 text-sm">
      <li class="flex justify-between gap-4 py-2.5">
        <span class="text-black/50 dark:text-white/50">Illustrative 60% ceiling</span>
        <span class="text-black dark:text-white" id="band-60">—</span>
      </li>
      <li class="flex justify-between gap-4 py-2.5">
        <span class="text-black/50 dark:text-white/50">Illustrative 70% ceiling</span>
        <span class="text-black dark:text-white" id="band-70">—</span>
      </li>
    </ul>
    <p class="text-xs text-black/40 dark:text-white/40" id="out-note"></p>
  </div>

  <script is:inline>
    (function () {
      const rm = (n) => "RM " + Math.round(n).toLocaleString("en-MY");

      function pmt(principal, annualRate, years) {
        const n = years * 12;
        const i = annualRate / 100 / 12;
        if (n <= 0) return 0;
        if (i === 0) return principal / n;
        return (principal * i * Math.pow(1 + i, n)) / (Math.pow(1 + i, n) - 1);
      }

      function mode() {
        const checked = document.querySelector('input[name="mode"]:checked');
        return checked ? checked.value : "manual";
      }

      function syncMode() {
        const m = mode();
        document.getElementById("manual-wrap").classList.toggle("hidden", m !== "manual");
        document.getElementById("estimate-wrap").classList.toggle("hidden", m !== "estimate");
        recalc();
      }

      function recalc() {
        const income = Math.max(0, Number(document.getElementById("income").value) || 0);
        const commit = Math.max(0, Number(document.getElementById("commit").value) || 0);
        let house = 0;
        if (mode() === "manual") {
          house = Math.max(0, Number(document.getElementById("instalment").value) || 0);
        } else {
          house = pmt(
            Number(document.getElementById("loan").value) || 0,
            Number(document.getElementById("rate").value) || 0,
            Number(document.getElementById("years").value) || 1
          );
        }

        const dsr = income > 0 ? ((commit + house) / income) * 100 : 0;
        const max70 = Math.max(0, income * 0.7 - commit);
        const max60 = Math.max(0, income * 0.6 - commit);

        document.getElementById("out-house").textContent = rm(house);
        document.getElementById("out-dsr").textContent = dsr.toFixed(1) + "%";
        document.getElementById("out-max").textContent = rm(max70);
        document.getElementById("band-60").textContent =
          dsr <= 60 ? "Within band" : "Above — max housing ≈ " + rm(max60);
        document.getElementById("band-70").textContent =
          dsr <= 70 ? "Within band" : "Above — max housing ≈ " + rm(max70);
        document.getElementById("out-note").textContent =
          "Not a bank decision. Maybank / CIMB / Public Bank policies differ — use this for planning conversations only.";
      }

      document.querySelectorAll('input[name="mode"]').forEach((el) => el.addEventListener("change", syncMode));
      ["income", "commit", "instalment", "loan", "rate", "years"].forEach((id) => {
        document.getElementById(id).addEventListener("input", recalc);
      });
      syncMode();
    })();
  </script>
</ToolShell>
