---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import ProjectOwnerBadge from "@components/ProjectOwnerBadge.astro";
import GSendrFlowDiagram from "@components/GSendrFlowDiagram.astro";
import GSendrStats from "@components/GSendrStats.astro";
import { readingTime } from "@lib/utils";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: project,
  }));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await project.render();

const projectURL = project.data.projectURL || project.data.demoURL;

function normalizeProjectImagePath(path: string): string {
  if (path.startsWith("http://") || path.startsWith("https://") || path.startsWith("/")) {
    return path;
  }
  return `/projects/${path}`;
}

function stripMarkdown(text: string): string {
  return text
    .replace(/\u0060{3}[\s\S]*?\u0060{3}/g, " ")
    .replace(/\u0060([^\u0060]+)\u0060/g, "$1")
    .replace(/!\[.*?\]\(.*?\)/g, " ")
    .replace(/\[(.*?)\]\(.*?\)/g, "$1")
    .replace(/[*_>#-]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function getOverviewSummary(body: string): string | null {
  const match = body.match(/##\s+Overview\s+([\s\S]*?)(\n##\s+|\n###\s+|$)/i);
  if (!match?.[1]) return null;
  const firstParagraph = match[1].split(/\n\s*\n/).find((paragraph) => paragraph.trim().length > 0);
  if (!firstParagraph) return null;
  return stripMarkdown(firstParagraph);
}

function getResultsFromBody(body: string): string[] {
  const keyAchievementsBlock = body.match(/Key achievements include:\s*([\s\S]*?)(\n##\s+|$)/i);
  if (keyAchievementsBlock?.[1]) {
    const bullets = keyAchievementsBlock[1]
      .split("\n")
      .map((line) => line.trim())
      .filter((line) => line.startsWith("-"))
      .map((line) => stripMarkdown(line.replace(/^-+\s*/, "")))
      .filter(Boolean);
    if (bullets.length > 0) return bullets.slice(0, 4);
  }

  const singleAchievement = body.match(/\*\*Key Achievement\*\*:\s*(.+)/i);
  if (singleAchievement?.[1]) {
    return [stripMarkdown(singleAchievement[1])];
  }

  return [];
}

function getSectionBlock(body: string, headings: string[]): string | null {
  for (const heading of headings) {
    const escapedHeading = heading.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const regex = new RegExp(`##\\s+${escapedHeading}\\s+([\\s\\S]*?)(\\n##\\s+|$)`, "i");
    const match = body.match(regex);
    if (match?.[1]) return match[1].trim();
  }
  return null;
}

function getBulletsFromBlock(block: string | null, max = 5): string[] {
  if (!block) return [];
  const bullets = block
    .split("\n")
    .map((line) => line.trim())
    .filter((line) => /^(-|\*|\d+\.)\s+/.test(line))
    .map((line) => stripMarkdown(line.replace(/^(-|\*|\d+\.)\s+/, "")))
    .filter(Boolean);
  return bullets.slice(0, max);
}

const isProtected = !!project.data.password;
const projectSlug = project.slug;
const correctPassword = project.data.password || "";
const projectImage = project.data.featuredImage
  ? normalizeProjectImagePath(project.data.featuredImage)
  : "/og-image.png";
const projectKeywords = [
  project.data.title,
  "case study",
  "saas case study",
  project.data.role,
  project.data.client,
  ...(project.data.techStack || []),
  "sattiyan selvarajah",
]
  .filter(Boolean)
  .join(", ");

const caseStudyProblem = project.data.problem || project.data.description;
const caseStudySolution =
  project.data.solution || getOverviewSummary(project.body) || project.data.description;
const caseStudyResults = Array.isArray(project.data.results)
  ? project.data.results
  : project.data.results
    ? [project.data.results]
    : getResultsFromBody(project.body);

const keyFeatures = (() => {
  const featureBlock = getSectionBlock(project.body, [
    "Features",
    "Key Features",
    "Core Features",
    "What I Built",
    "Implementation",
  ]);
  const featureBullets = getBulletsFromBlock(featureBlock, 5);
  if (featureBullets.length > 0) return featureBullets;
  if (caseStudyResults.length > 0) return caseStudyResults.slice(0, 5).map((result) => stripMarkdown(result));
  if (project.data.techStack?.length) {
    return project.data.techStack.slice(0, 5).map((tech) => `Built using ${tech}.`);
  }
  return ["Delivered a production-ready implementation with core user flows in place."];
})();

const relatedPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && post.data.project === project.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout
  title={`${project.data.title} — Case Study`}
  description={project.data.description}
  keywords={projectKeywords}
  image={projectImage}
>
  <Container>
    <div class="space-y-8 sm:space-y-10">
      <nav class="flex items-center space-x-2 text-sm text-black/50 dark:text-white/50">
        <a href="/" class="hover:text-black dark:hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/projects" class="hover:text-black dark:hover:text-white transition-colors">Projects</a>
        <span>/</span>
        <span class="text-black dark:text-white font-medium truncate">{project.data.title}</span>
      </nav>

      {
        isProtected && (
          <div id="password-protection" class="hidden">
            <div class="max-w-md mx-auto mt-8 p-6 border border-black/15 dark:border-white/20">
              <div class="text-center mb-6">
                <h2 class="text-xl font-semibold text-black dark:text-white mb-2">Protected Project</h2>
                <p class="text-sm text-black/60 dark:text-white/60">
                  Enter the password to view this case study.
                </p>
              </div>
              <form id="password-form" class="space-y-4">
                <div>
                  <label
                    for="project-password"
                    class="block text-sm font-medium text-black/70 dark:text-white/70 mb-2"
                  >
                    Password
                  </label>
                  <input
                    type="password"
                    id="project-password"
                    name="password"
                    required
                    class="w-full px-4 py-2 border border-black/15 dark:border-white/20 bg-white dark:bg-black text-black dark:text-white focus:outline-none focus:ring-2 focus:ring-black/20 dark:focus:ring-white/20"
                    placeholder="Enter password"
                    autocomplete="off"
                  />
                </div>
                <div id="password-error" class="hidden text-sm text-red-600 dark:text-red-400"></div>
                <button
                  type="submit"
                  class="w-full px-4 py-2.5 rounded-full bg-black dark:bg-white text-white dark:text-black font-medium hover:opacity-90 transition-opacity"
                >
                  Unlock Project
                </button>
              </form>
            </div>
          </div>
        )
      }

      <div id="project-content" class:list={["space-y-10 sm:space-y-12", isProtected && "hidden"]}>
        <!-- Hero -->
        <header class="space-y-4">
          <p class="text-xs font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">
            Case study
          </p>
          <h1 class="text-2xl sm:text-3xl font-semibold text-black dark:text-white leading-tight">
            {project.data.title}
          </h1>
          <p class="text-base text-black/70 dark:text-white/70 leading-relaxed max-w-3xl">
            {project.data.description}
          </p>

          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-black/50 dark:text-white/50">
            <span>{project.data.date.getFullYear()}</span>
            <span>&bull;</span>
            <span>{readingTime(project.body)}</span>
            {
              project.data.role && (
                <>
                  <span>&bull;</span>
                  <span>{project.data.role}</span>
                </>
              )
            }
            {
              projectURL && (
                <>
                  <span>&bull;</span>
                  <Link
                    href={projectURL}
                    external
                    class="hover:text-black dark:hover:text-white transition-colors no-underline"
                  >
                    Live site
                  </Link>
                </>
              )
            }
            {
              project.data.repoURL && (
                <>
                  <span>&bull;</span>
                  <Link
                    href={project.data.repoURL}
                    external
                    class="hover:text-black dark:hover:text-white transition-colors no-underline"
                  >
                    Code
                  </Link>
                </>
              )
            }
          </div>

          {
            (project.data.client || project.data.projectOwner) && (
              <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                {project.data.projectOwner && (
                  <div class="space-y-1">
                    <p class="text-[11px] font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">
                      Project owner
                    </p>
                    <ProjectOwnerBadge owner={project.data.projectOwner} size="md" />
                  </div>
                )}
                {project.data.client && (
                  <div class="space-y-1">
                    <p class="text-[11px] font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">
                      Client
                    </p>
                    <p class="text-sm font-medium text-black/70 dark:text-white/70">
                      {project.data.client}
                    </p>
                  </div>
                )}
              </div>
            )
          }

          {
            project.data.techStack && project.data.techStack.length > 0 && (
              <p class="text-sm text-black/55 dark:text-white/55 leading-relaxed max-w-3xl">
                <span class="text-black/40 dark:text-white/40">Stack · </span>
                {project.data.techStack.join(" · ")}
              </p>
            )
          }
        </header>

        <!-- Metrics -->
        {project.slug === "gsendr" && <GSendrStats />}
        {
          project.slug !== "gsendr" && project.data.metrics && project.data.metrics.length > 0 && (
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              {project.data.metrics.map((metric) => (
                <div class="rounded-2xl border border-black/15 dark:border-white/15 px-4 py-3">
                  <p class="text-sm font-semibold text-black dark:text-white">{metric}</p>
                </div>
              ))}
            </div>
          )
        }

        <!-- Screenshots -->
        {project.slug === "gsendr" && <GSendrFlowDiagram />}
        {
          project.slug !== "gsendr" && project.data.screenshots && project.data.screenshots.length > 0 && (
            <div class="screenshot-slider flex flex-col md:flex-row gap-4" data-slider-id={`slider-${project.slug}`}>
              {project.data.screenshots.length > 1 && (
                <div class="flex md:flex-col gap-2 overflow-x-auto md:overflow-x-visible md:overflow-y-auto pb-2 md:pb-0 order-2 md:order-1">
                  {project.data.screenshots.map((screenshot, index) => (
                    <button
                      class={`screenshot-thumb flex-shrink-0 w-16 h-16 md:w-20 md:h-20 overflow-hidden border-2 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-black/20 dark:focus:ring-white/20 hover:border-black/30 dark:hover:border-white/30 ${index === 0 ? "border-black/50 dark:border-white/50" : "border-transparent"}`}
                      data-index={index}
                      aria-label={`View screenshot ${index + 1}`}
                    >
                      <img
                        src={normalizeProjectImagePath(screenshot)}
                        alt={`Thumbnail ${index + 1}`}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    </button>
                  ))}
                </div>
              )}

              <div class="relative overflow-hidden border border-black/15 dark:border-white/20 bg-black/[0.03] dark:bg-white/[0.03] flex-1 order-1 md:order-2">
                <div class="screenshot-main-container relative aspect-video">
                  {project.data.screenshots.map((screenshot, index) => (
                    <img
                      src={normalizeProjectImagePath(screenshot)}
                      alt={`${project.data.title} screenshot ${index + 1}`}
                      class={`screenshot-main w-full h-full object-contain transition-opacity duration-300 ${index === 0 ? "opacity-100" : "opacity-0 absolute inset-0"}`}
                      data-index={index}
                      loading={index === 0 ? "eager" : "lazy"}
                    />
                  ))}
                </div>

                {project.data.screenshots.length > 1 && (
                  <>
                    <button
                      class="screenshot-prev absolute left-2 top-1/2 -translate-y-1/2 p-2 bg-black/50 dark:bg-white/50 text-white dark:text-black hover:bg-black/70 dark:hover:bg-white/70 transition-colors"
                      aria-label="Previous screenshot"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                      </svg>
                    </button>
                    <button
                      class="screenshot-next absolute right-2 top-1/2 -translate-y-1/2 p-2 bg-black/50 dark:bg-white/50 text-white dark:text-black hover:bg-black/70 dark:hover:bg-white/70 transition-colors"
                      aria-label="Next screenshot"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </button>
                  </>
                )}
              </div>
            </div>
          )
        }

        <!-- Problem / Solution / Results -->
        <section class="space-y-5">
          <div class="border border-black/15 dark:border-white/15 rounded-2xl p-5 sm:p-6 space-y-3">
            <h2 class="text-xs font-semibold uppercase tracking-wide text-black/45 dark:text-white/45">
              Problem
            </h2>
            <p class="text-sm text-black/80 dark:text-white/80 leading-relaxed">{caseStudyProblem}</p>
          </div>
          <div class="border border-black/15 dark:border-white/15 rounded-2xl p-5 sm:p-6 space-y-3">
            <h2 class="text-xs font-semibold uppercase tracking-wide text-black/45 dark:text-white/45">
              Solution
            </h2>
            <p class="text-sm text-black/80 dark:text-white/80 leading-relaxed">{caseStudySolution}</p>
          </div>
          {
            caseStudyResults.length > 0 && (
              <div class="border border-black/15 dark:border-white/15 rounded-2xl p-5 sm:p-6 space-y-4">
                <h2 class="text-xs font-semibold uppercase tracking-wide text-black/45 dark:text-white/45">
                  Results
                </h2>
                <ul class="space-y-3">
                  {caseStudyResults.map((result) => (
                    <li class="text-sm text-black/80 dark:text-white/80 leading-relaxed flex gap-2">
                      <span class="text-black/30 dark:text-white/30 shrink-0">—</span>
                      <span>{result}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </section>

        <!-- Key features from body (when present) -->
        {
          keyFeatures.length > 0 && (
            <section class="space-y-4">
              <h2 class="text-xs font-semibold uppercase tracking-wide text-black/45 dark:text-white/45">
                What shipped
              </h2>
              <ul class="space-y-3">
                {keyFeatures.map((feature) => (
                  <li class="text-sm text-black/75 dark:text-white/75 leading-relaxed flex gap-2">
                    <span class="text-black/30 dark:text-white/30 shrink-0">—</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <!-- Full markdown body -->
        <article class="prose prose-sm dark:prose-invert max-w-none border-t border-black/10 dark:border-white/10 pt-10 prose-headings:mt-10 prose-headings:mb-4 prose-h2:mt-12 first:prose-headings:mt-0 prose-p:my-4 prose-li:my-1.5 prose-ul:my-4 prose-ol:my-4">
          <Content />
        </article>

        {
          relatedPosts.length > 0 && (
            <section class="space-y-4 border-t border-black/10 dark:border-white/10 pt-10">
              <h2 class="text-xs font-semibold uppercase tracking-wide text-black/45 dark:text-white/45">
                Related notes
              </h2>
              <ul class="divide-y divide-black/10 dark:divide-white/10 border-t border-b border-black/10 dark:border-white/10">
                {relatedPosts.map((post) => (
                  <li>
                    <a
                      href={`/blog/${post.slug}`}
                      class="group flex flex-col gap-1.5 py-5 no-underline hover:opacity-80 transition-opacity"
                    >
                      <span class="text-sm font-semibold text-black dark:text-white">{post.data.title}</span>
                      <span class="text-sm text-black/60 dark:text-white/60 line-clamp-2">{post.data.description}</span>
                      <span class="text-xs text-black/40 dark:text-white/40">Read →</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <!-- CTA -->
        <section class="space-y-4 border-t border-black/10 dark:border-white/10 pt-10 mt-2">
          <h2 class="text-lg font-semibold text-black dark:text-white">Need something similar?</h2>
          <p class="text-sm text-black/65 dark:text-white/65 leading-relaxed max-w-xl">
            I build production web systems end-to-end — product, architecture, and shipping.
          </p>
          <div class="flex flex-wrap gap-3 pt-1">
            <a
              href="/hire"
              class="inline-flex items-center gap-1.5 rounded-full bg-black dark:bg-white px-5 py-2.5 text-sm font-semibold text-white dark:text-black hover:opacity-90 transition-opacity"
            >
              Hire me
            </a>
            <a
              href="/projects"
              class="inline-flex items-center rounded-full border border-black/15 dark:border-white/20 px-5 py-2.5 text-sm font-semibold text-black dark:text-white hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
            >
              More case studies
            </a>
          </div>
        </section>
      </div>
    </div>
  </Container>
</PageLayout>

{
  isProtected && (
    <script
      is:inline
      set:html={`
    (function() {
      const storageKey = 'project_unlocked_${projectSlug}';
      const correctPassword = '${correctPassword}';
      const passwordForm = document.getElementById('password-form');
      const passwordInput = document.getElementById('project-password');
      const passwordError = document.getElementById('password-error');
      const passwordProtection = document.getElementById('password-protection');
      const projectContent = document.getElementById('project-content');

      const isUnlocked = localStorage.getItem(storageKey) === 'true';
      
      if (isUnlocked) {
        if (passwordProtection) passwordProtection.classList.add('hidden');
        if (projectContent) projectContent.classList.remove('hidden');
      } else {
        if (passwordProtection) passwordProtection.classList.remove('hidden');
        if (projectContent) projectContent.classList.add('hidden');
      }

      if (passwordForm) {
        passwordForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const enteredPassword = passwordInput.value.trim();

          if (enteredPassword === correctPassword) {
            localStorage.setItem(storageKey, 'true');
            if (passwordProtection) passwordProtection.classList.add('hidden');
            if (projectContent) projectContent.classList.remove('hidden');
            if (passwordError) passwordError.classList.add('hidden');
            passwordInput.value = '';
          } else {
            if (passwordError) {
              passwordError.textContent = 'Incorrect password. Please try again.';
              passwordError.classList.remove('hidden');
            }
            passwordInput.value = '';
            passwordInput.focus();
          }
        });
      }
    })();
  `}
    />
  )
}

{
  project.data.screenshots && project.data.screenshots.length > 1 && (
    <script
      is:inline
      set:html={`
    (function() {
      const sliderId = 'slider-${project.slug}';
      const totalImages = ${project.data.screenshots.length};
      const slider = document.querySelector(\`[data-slider-id="\${sliderId}"]\`);
      if (!slider) return;
      
      let currentIndex = 0;
      const mainImages = slider.querySelectorAll('.screenshot-main');
      const thumbnails = slider.querySelectorAll('.screenshot-thumb');
      const prevBtn = slider.querySelector('.screenshot-prev');
      const nextBtn = slider.querySelector('.screenshot-next');
      
      function updateSlider(index) {
        mainImages.forEach((img, i) => {
          if (i === index) {
            img.classList.remove('opacity-0', 'absolute');
            img.classList.add('opacity-100');
          } else {
            img.classList.remove('opacity-100');
            img.classList.add('opacity-0', 'absolute');
          }
        });
        
        thumbnails.forEach((thumb, i) => {
          if (i === index) {
            thumb.classList.add('border-black/50', 'dark:border-white/50');
            thumb.classList.remove('border-transparent');
          } else {
            thumb.classList.remove('border-black/50', 'dark:border-white/50');
            thumb.classList.add('border-transparent');
          }
        });
      }
      
      function goToSlide(index) {
        currentIndex = index;
        updateSlider(currentIndex);
      }
      
      function nextSlide() {
        currentIndex = (currentIndex + 1) % totalImages;
        updateSlider(currentIndex);
      }
      
      function prevSlide() {
        currentIndex = (currentIndex - 1 + totalImages) % totalImages;
        updateSlider(currentIndex);
      }
      
      if (prevBtn) prevBtn.addEventListener('click', prevSlide);
      if (nextBtn) nextBtn.addEventListener('click', nextSlide);
      
      thumbnails.forEach((thumb, index) => {
        thumb.addEventListener('click', () => goToSlide(index));
      });
      
      slider.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') prevSlide();
        if (e.key === 'ArrowRight') nextSlide();
      });
      
      updateSlider(0);
    })();
  `}
    />
  )
}
