---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import RecommendationsSection from "@components/RecommendationsSection.astro";
import AvailabilityStatus from "@components/AvailabilityStatus.astro";
import HeroVisual from "@components/HeroVisual.astro";
import WorkExperienceCard from "@components/WorkExperienceCard.astro";
import FeaturedProjectsShowcase from "@components/FeaturedProjectsShowcase.astro";
import RecentlyWatched from "@components/RecentlyWatched.astro";
import TechMarquee from "@components/TechMarquee.astro";
import ContactCTA from "@components/ContactCTA.astro";
import WhatIDo from "@components/WhatIDo.astro";
import FeaturedQuote from "@components/FeaturedQuote.astro";
import FreelanceLeadModal from "@components/FreelanceLeadModal.astro";
import BrandMark from "@components/BrandMark.astro";
import { SITE, HOME, SOCIALS } from "@consts";


const linkedinUrl =
  SOCIALS.find((social) => social.NAME === "LinkedIn")?.HREF ??
  "https://www.linkedin.com/in/sattiyans";

const workCollection = await getCollection("work");
const work = workCollection
  .filter((entry) => entry.data.dateEnd === "Current")
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf());

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft && !project.data.password) // Hide password-protected projects from home page
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} keywords={HOME.KEYWORDS}>
  <Container>
    <!-- Hero Section -->
    <section class="mb-10">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_minmax(300px,360px)] gap-8 lg:gap-12 items-center mb-8">
        <!-- Left: intro + positioning + CTA -->
        <div>
      <!-- Top: avatar + greeting + availability -->
      <div class="animate flex items-center gap-4 mb-4">
        <BrandMark size={64} class="w-14 h-14 sm:w-16 sm:h-16 shrink-0" />
        <div class="flex flex-col gap-2">
          <h1 class="text-2xl md:text-3xl font-semibold text-black dark:text-white leading-tight">
            Hey, I'm <span class="name-shimmer">Sattiyan</span> <span class="inline-block text-3xl wave">👋🏻</span>
          </h1>
          <div class="flex flex-wrap items-center gap-2">
            <AvailabilityStatus />
            <span class="text-xs text-gray-500 dark:text-gray-400">Open to freelance engagements</span>
          </div>
        </div>
      </div>

      <!-- Positioning -->
      <p class="animate text-lg text-gray-700 dark:text-gray-200 font-medium mb-1">
        Technology Lead @ G6 Labs Asia · Founder, Dotkod Solutions
      </p>
      <p class="animate text-sm text-gray-500 dark:text-gray-400 mb-2">
        System architecture, product engineering & GenAI automation — Laravel, Node.js & Python
      </p>
      <p class="animate flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400 mb-5">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        Kuala Lumpur, Malaysia · Remote-friendly
      </p>

        <div class="flex flex-wrap items-center gap-2.5 mb-6 lg:mb-8">
        <Link
          href="/hire"
          underline={false}
          class="group inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold bg-black text-white dark:bg-white dark:text-black hover:opacity-90 transition-opacity duration-200"
        >
          Hire me
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </Link>
        <Link href="/cv" underline={false} aria-label="View CV" class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium border border-black/15 dark:border-white/20 text-gray-700 dark:text-gray-300 hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-200">CV</Link>
        <Link href={linkedinUrl} external underline={false} class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium border border-black/15 dark:border-white/20 text-gray-700 dark:text-gray-300 hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-200">LinkedIn</Link>
        <div class="flex items-center gap-2.5 pl-1">
          {SOCIALS.filter((s) => s.NAME === "GitHub" || s.NAME === "Threads").map((social) => (
            <Link
              href={social.HREF}
              external
              underline={false}
              aria-label={`${SITE.NAME} on ${social.NAME}`}
              class="inline-flex shrink-0 text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-white transition-colors duration-200"
            >
              {social.NAME === "GitHub" ? (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              ) : (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 192 192" aria-hidden="true">
                  <path d="M141.537 88.9883C140.71 88.5919 139.87 88.2104 139.019 87.8451C137.537 60.5382 122.616 44.905 97.5619 44.745C97.4484 44.7443 97.3355 44.7443 97.222 44.7443C82.2364 44.7443 69.7731 51.1409 62.102 62.7807L75.881 72.2328C81.6116 63.5383 90.6052 61.6848 97.2286 61.6848C97.3051 61.6848 97.3819 61.6848 97.4576 61.6855C105.707 61.7381 111.932 64.1366 115.961 68.814C118.893 72.2193 120.854 76.925 121.825 82.8638C114.511 81.6207 106.601 81.2385 98.145 81.7233C74.3247 83.0954 59.0111 96.9879 60.0396 116.292C60.5615 126.084 65.4397 134.508 73.775 140.011C80.8224 144.663 89.899 146.938 99.3323 146.423C111.79 145.74 121.563 140.987 128.381 132.296C133.559 125.696 136.834 117.143 138.28 106.366C144.217 109.949 148.617 114.664 151.047 120.332C155.179 129.967 155.42 145.8 142.501 158.708C131.182 170.016 117.576 174.908 97.0135 175.059C74.2042 174.89 56.9538 167.575 45.7381 153.317C35.2355 139.966 29.8077 120.682 29.6052 96C29.8077 71.3178 35.2355 52.0336 45.7381 38.6827C56.9538 24.4249 74.2039 17.11 97.0132 16.9405C119.988 17.1113 137.539 24.4614 149.184 38.788C154.894 45.8136 159.199 54.6488 162.037 64.9503L178.184 60.6422C174.744 47.9622 169.331 37.0357 161.965 27.974C147.036 9.60668 125.202 0.195148 97.0695 0H96.9569C68.8816 0.19447 47.2921 9.6418 32.7883 28.0793C19.8819 44.4864 13.2244 67.3157 13.0007 95.9325L13 96L13.0007 96.0675C13.2244 124.684 19.8819 147.514 32.7883 163.921C47.2921 182.358 68.8816 191.806 96.9569 192H97.0695C122.03 191.827 139.624 185.292 154.118 170.811C173.081 151.866 172.51 128.119 166.26 113.541C161.776 103.087 153.227 94.5962 141.537 88.9883ZM98.4405 129.507C88.0005 130.095 77.1544 125.409 76.6196 115.372C76.2232 107.93 81.9158 99.626 99.0812 98.6368C101.047 98.5234 102.976 98.468 104.871 98.468C111.106 98.468 116.939 99.0737 122.242 100.233C120.264 124.935 108.662 128.946 98.4405 129.507Z"/>
                </svg>
              )}
            </Link>
          ))}
        </div>
        </div>
        </div>
        <!-- Right: animated systems + AI visual (compact on mobile) -->
        <div class="-mx-1 lg:mx-0">
          <HeroVisual />
        </div>
      </div>

      <!-- Proof strip — capability signals, not product promo -->
      <div class="animate grid grid-cols-2 sm:grid-cols-4 gap-px rounded-xl border border-black/10 dark:border-white/10 overflow-hidden bg-black/[0.06] dark:bg-white/[0.08]">
        <div class="bg-white dark:bg-black p-4">
          <div class="text-lg font-semibold text-black dark:text-white">End-to-end</div>
          <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">architecture → production</div>
        </div>
        <div class="bg-white dark:bg-black p-4">
          <div class="text-lg font-semibold text-black dark:text-white">Enterprise</div>
          <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">multi-tenant SaaS at scale</div>
        </div>
        <div class="bg-white dark:bg-black p-4">
          <div class="text-lg font-semibold text-black dark:text-white">7+ yrs</div>
          <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">shipping production software</div>
        </div>
        <div class="bg-white dark:bg-black p-4">
          <div class="text-lg font-semibold text-black dark:text-white">Fault-tolerant</div>
          <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">event-driven systems</div>
        </div>
      </div>
    </section>

    <div class="space-y-12">
      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white m-0">About</h5>
        <article class="space-y-4">
          <p class="animate">
            I'm a Technology Lead at <Link href="https://www.g6labs.asia" external>G6 Labs Asia</Link> and founder of <Link href="https://www.dotkod.com" external>Dotkod Solutions</Link>. I specialize in taking SaaS products from architecture through production — designing fault-tolerant, event-driven systems and GenAI workflows with Laravel, Node.js, and Python. I lead engineering standards, own technical roadmaps, and build platforms meant to scale without breaking under real traffic.
          </p>
          <p class="animate">
            My track record includes shipping production platforms such as GBoost.ai and GSendr at <Link href="https://www.g6labs.asia" external>G6 Labs</Link>, and FEMO, Invested, and sports web applications at <Link href="https://www.trisquare.com.my" external>TriSquare Technology</Link> — multi-tenant SaaS, Official WhatsApp Cloud API at campaign scale, payment integrations, admin dashboards, API-heavy backends, and AI-assisted automation. Through <Link href="https://www.dotkod.com" external>Dotkod Solutions</Link>, I also take on freelance engagements for startups and SMEs, delivering custom web apps, e-commerce, and proprietary AI systems from scoping to deployment. I started my career in game development with Unreal Engine and Unity — you can still find those projects on <Link href="https://sattiyans.itch.io/" external>itch.io</Link>.
          </p>
        </article>
      </section>

      <WhatIDo />

      <section class="animate space-y-4">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white m-0">
            Current Roles
          </h5>
          <Link
            href="/work"
            underline={false}
            class="group inline-flex items-center gap-1 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-white"
          >
            See all work
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </Link>
        </div>
        <div class="max-w-2xl">
          {work.map((entry, index) => (
            <WorkExperienceCard
              entry={entry}
              compact={true}
              isLast={index === work.length - 1}
            />
          ))}
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Now shipping: WhatsApp + Voice Blast on GSendr · AI Google Ads on GBoost
        </p>
      </section>

      <FeaturedProjectsShowcase projects={projects} />

      <FeaturedQuote />

      <ContactCTA />

      <TechMarquee />

      <section class="animate space-y-6">
        <RecommendationsSection limit={3} />
      </section>

      <RecentlyWatched />
    </div>
  </Container>

  <FreelanceLeadModal />
</PageLayout>

<style>
  .name-shimmer {
    background: linear-gradient(90deg, #111827 0%, #16a34a 45%, #111827 90%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: name-shimmer 5s ease-in-out infinite;
  }
  :global(.dark) .name-shimmer {
    background: linear-gradient(90deg, #ffffff 0%, #4ade80 45%, #ffffff 90%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
  }
  @keyframes name-shimmer {
    0% { background-position: 0% center; }
    100% { background-position: 200% center; }
  }
  .wave {
    transform-origin: 70% 70%;
    animation: wave 2.6s ease-in-out infinite;
  }
  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .name-shimmer { animation: none; }
    .wave { animation: none; }
  }
</style>
