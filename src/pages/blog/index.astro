---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import { BLOG } from "@consts";

const data = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type Acc = {
  [year: string]: CollectionEntry<"blog">[];
};

const posts = data.reduce((acc: Acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION} keywords={BLOG.KEYWORDS}>
  <Container>
    <div class="space-y-10">
      <nav class="flex items-center space-x-2 text-sm text-black/50 dark:text-white/50">
        <a href="/" class="hover:text-black dark:hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-black dark:text-white font-medium">Blog</span>
      </nav>

      <header class="space-y-3">
        <h1 class="animate text-2xl sm:text-3xl font-semibold text-black dark:text-white tracking-tight">
          Blog
        </h1>
        <p class="animate text-sm text-black/70 dark:text-white/70 max-w-xl leading-relaxed">
          Notes on shipping SaaS — architecture, WhatsApp Cloud API campaigns, and production lessons.
        </p>
      </header>

      {
        years.length === 0 ? (
          <p class="text-sm text-black/50 dark:text-white/50">No posts yet.</p>
        ) : (
          <div class="space-y-12">
            {years.map((year) => (
              <section class="animate space-y-4">
                <h2 class="text-sm font-semibold tracking-wide uppercase text-black/50 dark:text-white/50">
                  {year}
                </h2>
                <ul class="divide-y divide-black/10 dark:divide-white/10 border-t border-b border-black/10 dark:border-white/10">
                  {posts[year].map((post) => (
                    <li>
                      <a
                        href={`/blog/${post.slug}`}
                        class="group flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-8 py-6 no-underline hover:bg-black/[0.02] dark:hover:bg-white/[0.03] -mx-2 px-2 transition-colors"
                      >
                        <time class="shrink-0 text-xs text-black/45 dark:text-white/45 sm:w-28 tabular-nums">
                          <FormattedDate date={post.data.date} />
                        </time>
                        <div class="min-w-0 flex-1 space-y-2">
                          <div class="flex flex-wrap items-center gap-2">
                            <h3 class="text-base font-semibold text-black dark:text-white group-hover:opacity-80 transition-opacity">
                              {post.data.title}
                            </h3>
                            {post.data.project && (
                              <span class="text-[11px] font-medium uppercase tracking-wide text-black/45 dark:text-white/45">
                                {post.data.project}
                              </span>
                            )}
                            {post.data.tool && (
                              <span class="text-[11px] font-medium uppercase tracking-wide text-black/45 dark:text-white/45">
                                tool · {post.data.tool}
                              </span>
                            )}
                          </div>
                          <p class="text-sm text-black/60 dark:text-white/60 leading-relaxed line-clamp-2">
                            {post.data.description}
                          </p>
                          <p class="text-xs text-black/40 dark:text-white/40">
                            {readingTime(post.body)}
                            <span class="ml-2 opacity-0 group-hover:opacity-100 transition-opacity">Read →</span>
                          </p>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        )
      }
    </div>
  </Container>
</PageLayout>
