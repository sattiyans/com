---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import WorkExperienceCard from "@components/WorkExperienceCard.astro";
import { WORK, SITE, SOCIALS } from "@consts";
import Link from "@components/Link.astro";

const collection = (await getCollection("work")).sort(
  (a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf()
);

const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

const linkedinUrl =
  SOCIALS.find((social) => social.NAME === "LinkedIn")?.HREF ??
  "https://www.linkedin.com/in/sattiyans";

const currentRole = work.find((entry) => entry.data.dateEnd === "Current");
const companies = [...new Set(work.map((entry) => entry.data.company))];
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION} keywords={WORK.KEYWORDS}>
  <Container>
    <div class="space-y-10">
      <nav class="flex items-center space-x-2 text-sm text-black/50 dark:text-white/50">
        <Link href="/" underline={false} class="hover:text-black dark:hover:text-white transition-colors">
          Home
        </Link>
        <span>/</span>
        <span class="text-black dark:text-white font-medium">Work</span>
      </nav>

      <div class="grid gap-10 lg:grid-cols-[1fr_minmax(240px,300px)] lg:gap-14 items-start">
        <!-- Timeline -->
        <div class="min-w-0 space-y-2">
          <header class="space-y-3 mb-8 lg:mb-10">
            <h1 class="text-2xl sm:text-3xl font-semibold text-black dark:text-white tracking-tight">
              Work
            </h1>
            <p class="text-sm text-black/60 dark:text-white/60 leading-relaxed max-w-xl">
              Technology Lead and product engineer — SaaS platforms, architecture, and shipping systems that hold up in production.
            </p>
          </header>

          <div>
            {
              work.map((entry, index) => (
                <div class="animate">
                  <WorkExperienceCard entry={entry} isLast={index === work.length - 1}>
                    <entry.Content />
                  </WorkExperienceCard>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Sticky aside — fills the empty right column -->
        <aside class="lg:sticky lg:top-28 space-y-6">
          <div class="rounded-2xl border border-black/15 dark:border-white/15 p-5 space-y-5">
            <div class="space-y-1">
              <p class="text-[11px] font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">
                Now
              </p>
              {
                currentRole ? (
                  <div class="space-y-1">
                    <p class="text-sm font-semibold text-black dark:text-white leading-snug">
                      {currentRole.data.role}
                    </p>
                    <p class="text-xs text-black/55 dark:text-white/55">{currentRole.data.company}</p>
                  </div>
                ) : (
                  <p class="text-sm text-black/60 dark:text-white/60">Open to opportunities</p>
                )
              }
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="rounded-xl border border-black/10 dark:border-white/10 px-3 py-2.5">
                <p class="text-lg font-semibold text-black dark:text-white">{work.length}</p>
                <p class="text-[11px] text-black/45 dark:text-white/45">roles</p>
              </div>
              <div class="rounded-xl border border-black/10 dark:border-white/10 px-3 py-2.5">
                <p class="text-lg font-semibold text-black dark:text-white">{companies.length}</p>
                <p class="text-[11px] text-black/45 dark:text-white/45">companies</p>
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <Link
                href="/hire"
                underline={false}
                class="inline-flex items-center justify-center rounded-full bg-black dark:bg-white px-4 py-2.5 text-sm font-semibold text-white dark:text-black hover:opacity-90 transition-opacity"
              >
                Hire me
              </Link>
              <Link
                href="/cv"
                underline={false}
                class="inline-flex items-center justify-center rounded-full border border-black/15 dark:border-white/20 px-4 py-2.5 text-sm font-semibold text-black dark:text-white hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              >
                View CV
              </Link>
              <Link
                href={linkedinUrl}
                external
                underline={false}
                class="inline-flex items-center justify-center gap-2 rounded-full border border-black/15 dark:border-white/20 px-4 py-2.5 text-sm font-semibold text-black dark:text-white hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              >
                LinkedIn
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
              </Link>
              <a
                href={`mailto:${SITE.EMAIL}`}
                class="inline-flex items-center justify-center rounded-full border border-black/15 dark:border-white/20 px-4 py-2.5 text-sm font-semibold text-black dark:text-white hover:bg-black/5 dark:hover:bg-white/5 transition-colors no-underline"
              >
                Email
              </a>
            </div>
          </div>

          <p class="text-xs text-black/40 dark:text-white/40 leading-relaxed px-1">
            Prefer a one-pager? The{" "}
            <Link href="/cv" underline={false} class="underline underline-offset-2 hover:text-black dark:hover:text-white">
              CV
            </Link>{" "}
            is print-ready.
          </p>
        </aside>
      </div>
    </div>
  </Container>
</PageLayout>
