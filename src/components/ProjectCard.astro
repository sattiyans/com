---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import ProjectOwnerBadge from "./ProjectOwnerBadge.astro";

type Props = {
  entry: CollectionEntry<"projects">;
  featured?: boolean;
};

const { entry, featured = false } = Astro.props;
const data = entry.data;

function normalizeProjectImagePath(path: string): string {
  if (path.startsWith("http://") || path.startsWith("https://") || path.startsWith("/")) {
    return path;
  }
  return `/projects/${path}`;
}

const imageSrc =
  data.featuredImage || data.thumbnail || data.screenshots?.[0]
    ? normalizeProjectImagePath(data.featuredImage || data.thumbnail || data.screenshots![0])
    : undefined;
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class:list={[
    "group block no-underline transition-opacity hover:opacity-90",
    featured
      ? "space-y-4"
      : "flex gap-4 sm:gap-5 items-start py-1",
  ]}
>
  {
    imageSrc && (
      <div
        class:list={[
          "overflow-hidden bg-black/[0.03] dark:bg-white/[0.04] shrink-0",
          featured ? "aspect-[16/10] w-full" : "w-20 h-20 sm:w-24 sm:h-24",
        ]}
      >
        <img
          src={imageSrc}
          alt=""
          class="w-full h-full object-cover"
          loading="lazy"
          width={featured ? 800 : 96}
          height={featured ? 500 : 96}
        />
      </div>
    )
  }

  <div class:list={["min-w-0 flex-1 flex flex-col gap-2", !featured && !imageSrc && "w-full"]}>
    <div class="flex w-full justify-between items-start gap-3">
      <div class="min-w-0 text-sm font-semibold text-black dark:text-white">
        {data.title}
      </div>
      <div class="shrink-0 text-xs whitespace-nowrap text-black/50 dark:text-white/50">
        <FormattedDate date={data.date} />
      </div>
    </div>

    {
      data.projectOwner && (
        <ProjectOwnerBadge owner={data.projectOwner} />
      )
    }

    {
      data.metrics && data.metrics.length > 0 && (
        <div class="flex flex-wrap gap-x-2 gap-y-1">
          {data.metrics.slice(0, featured ? 4 : 3).map((m) => (
            <span class="text-[11px] font-medium tracking-wide uppercase text-black/55 dark:text-white/55">
              {m}
            </span>
          ))}
        </div>
      )
    }

    <div class:list={["text-sm text-black/65 dark:text-white/65", featured ? "line-clamp-3" : "line-clamp-2"]}>
      {data.description}
    </div>

    {
      data.results && data.results.length > 0 && featured && (
        <p class="text-sm text-black/55 dark:text-white/55 line-clamp-2 border-l-2 border-black/15 dark:border-white/20 pl-3">
          {data.results[0]}
        </p>
      )
    }

    {
      data.techStack && data.techStack.length > 0 && featured && (
        <p class="text-xs text-black/45 dark:text-white/45">
          {data.techStack.slice(0, 6).join(" · ")}
        </p>
      )
    }
  </div>
</a>
