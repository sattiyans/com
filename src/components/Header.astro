---
import Link from "@components/Link.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const primaryLinks = [
  {
    href: "/",
    label: "Home",
    icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
  },
  {
    href: "/work",
    label: "Work",
    icon: "M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    href: "/projects",
    label: "Projects",
    icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
  },
  {
    href: "/blog",
    label: "Blog",
    icon: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z",
  },
] as const;

const moreLinks = [
  {
    href: "/tools",
    label: "Tools",
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z",
  },
  {
    href: "/uses",
    label: "Uses",
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    href: "/cv",
    label: "CV",
    icon: "M7 7h10M7 11h10M7 15h6M7 3h6l4 4v14H7z",
  },
] as const;

const allLinks = [...primaryLinks, ...moreLinks];

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}

const moreActive = moreLinks.some((link) => isActive(link.href));

function linkClass(active: boolean): string {
  return [
    "inline-flex shrink-0 items-center gap-1.5 rounded-full px-3 py-2 text-sm font-medium no-underline whitespace-nowrap transition-colors duration-200",
    active
      ? "bg-black text-white dark:bg-white dark:text-black"
      : "text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10",
  ].join(" ");
}
---

<header class="relative !fixed !top-0 !left-0 !right-0 !z-[10001] !py-0 !bg-transparent !backdrop-blur-none">
  <div class="fixed top-4 inset-x-0 z-[9999] flex justify-center px-3" id="floating-nav">
    <div class="relative">
      <!-- Mobile: expandable pill shell -->
      <nav
        id="nav-mobile-shell"
        class="nav-pill nav-mobile-shell lg:hidden border border-black/10 dark:border-white/15 bg-white/90 dark:bg-zinc-950/90 backdrop-blur-md shadow-lg shadow-black/10 dark:shadow-black/40"
        aria-label="Primary"
      >
        <div class="flex items-center gap-0.5 px-1.5 py-1.5">
          {
            primaryLinks.map((link) => {
              const active = isActive(link.href);
              return (
                <Link
                  href={link.href}
                  underline={false}
                  aria-current={active ? "page" : undefined}
                  class={linkClass(active)}
                >
                  <span>{link.label}</span>
                </Link>
              );
            })
          }
          <button
            type="button"
            id="nav-more-btn"
            class:list={[
              "inline-flex shrink-0 items-center gap-1 rounded-full px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors duration-200",
              moreActive
                ? "bg-black text-white dark:bg-white dark:text-black"
                : "text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10",
            ]}
            aria-expanded="false"
            aria-controls="nav-more-panel"
            aria-haspopup="true"
          >
            More
            <svg
              id="nav-more-chevron"
              class="w-3.5 h-3.5 opacity-70 transition-transform duration-300 ease-out"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>

        <div id="nav-more-panel" class="nav-more-panel" role="menu" aria-hidden="true">
          <div class="nav-more-panel-inner">
            <div class="mx-2 mb-2 border-t border-black/8 dark:border-white/10 pt-1.5 pb-1 space-y-0.5">
              {
                moreLinks.map((link) => {
                  const active = isActive(link.href);
                  return (
                    <Link
                      href={link.href}
                      underline={false}
                      role="menuitem"
                      aria-current={active ? "page" : undefined}
                      class={[
                        "flex w-full items-center gap-2.5 rounded-full px-3 py-2.5 text-sm font-medium no-underline transition-colors",
                        active
                          ? "bg-black text-white dark:bg-white dark:text-black"
                          : "text-gray-700 dark:text-gray-300 hover:bg-black/5 dark:hover:bg-white/10",
                      ].join(" ")}
                    >
                      <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        {link.href === "/tools" ? (
                          <>
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                            />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          </>
                        ) : (
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={link.icon} />
                        )}
                      </svg>
                      {link.label}
                    </Link>
                  );
                })
              }
            </div>
          </div>
        </div>
      </nav>

      <!-- Desktop: full pill -->
      <nav
        class="nav-pill hidden lg:flex items-center gap-0.5 rounded-full border border-black/10 dark:border-white/15 bg-white/90 dark:bg-zinc-950/90 backdrop-blur-md shadow-lg shadow-black/10 dark:shadow-black/40 px-1.5 py-1.5"
        aria-label="Primary"
      >
        {
          allLinks.map((link) => {
            const active = isActive(link.href);
            return (
              <Link
                href={link.href}
                underline={false}
                aria-current={active ? "page" : undefined}
                class={linkClass(active)}
              >
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  {link.href === "/tools" ? (
                    <>
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                      />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </>
                  ) : (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={link.icon} />
                  )}
                </svg>
                <span>{link.label}</span>
              </Link>
            );
          })
        }
      </nav>
    </div>
  </div>
  <div class="h-20"></div>
</header>

<style>
  #floating-nav {
    animation: slideDown 0.45s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #floating-nav.scrolled .nav-pill {
    box-shadow:
      0 20px 40px -12px rgba(0, 0, 0, 0.22),
      0 0 0 1px rgba(0, 0, 0, 0.04);
  }

  :global(.dark) #floating-nav.scrolled .nav-pill {
    box-shadow:
      0 20px 40px -12px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .nav-mobile-shell {
    border-radius: 9999px;
    overflow: hidden;
    transition:
      border-radius 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.32s ease;
  }

  .nav-mobile-shell.is-open {
    border-radius: 1.35rem;
  }

  .nav-more-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-mobile-shell.is-open .nav-more-panel {
    grid-template-rows: 1fr;
  }

  .nav-more-panel-inner {
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.22s ease,
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-mobile-shell.is-open .nav-more-panel-inner {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.04s;
  }

  .nav-mobile-shell.is-open #nav-more-chevron {
    transform: rotate(180deg);
  }
</style>

<script is:inline>
  (function () {
    function bindNav() {
      const floatingNav = document.getElementById("floating-nav");
      const shell = document.getElementById("nav-mobile-shell");
      const moreBtn = document.getElementById("nav-more-btn");
      const morePanel = document.getElementById("nav-more-panel");

      if (floatingNav) {
        const onScroll = function () {
          if (window.scrollY > 20) {
            floatingNav.classList.add("scrolled");
          } else {
            floatingNav.classList.remove("scrolled");
          }
        };
        window.removeEventListener("scroll", floatingNav._scrollHandler);
        floatingNav._scrollHandler = onScroll;
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }

      if (!shell || !moreBtn || !morePanel) return;

      const closeMore = function () {
        shell.classList.remove("is-open");
        moreBtn.setAttribute("aria-expanded", "false");
        morePanel.setAttribute("aria-hidden", "true");
      };

      const openMore = function () {
        shell.classList.add("is-open");
        moreBtn.setAttribute("aria-expanded", "true");
        morePanel.setAttribute("aria-hidden", "false");
      };

      const toggleMore = function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (shell.classList.contains("is-open")) {
          closeMore();
        } else {
          openMore();
        }
      };

      moreBtn.removeEventListener("click", moreBtn._toggleHandler);
      moreBtn._toggleHandler = toggleMore;
      moreBtn.addEventListener("click", toggleMore);

      document.removeEventListener("click", document._navOutsideHandler, true);
      document._navOutsideHandler = function (e) {
        if (!shell.classList.contains("is-open")) return;
        if (shell.contains(e.target)) return;
        closeMore();
      };
      document.addEventListener("click", document._navOutsideHandler, true);

      morePanel.removeEventListener("click", morePanel._linkHandler);
      morePanel._linkHandler = function (e) {
        if (e.target.closest("a")) closeMore();
      };
      morePanel.addEventListener("click", morePanel._linkHandler);

      document.removeEventListener("keydown", document._navEscHandler);
      document._navEscHandler = function (e) {
        if (e.key === "Escape") closeMore();
      };
      document.addEventListener("keydown", document._navEscHandler);

      closeMore();
    }

    document.addEventListener("DOMContentLoaded", bindNav);
    document.addEventListener("astro:page-load", bindNav);
    document.addEventListener("astro:after-swap", bindNav);
    if (document.readyState !== "loading") bindNav();
  })();
</script>
