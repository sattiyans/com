---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import type { ToolDef, ToolFaq } from "@data/tools";
import { relatedTools } from "@data/tools";
import { getCollection } from "astro:content";

type Props = {
  tool: ToolDef;
};

const { tool } = Astro.props;
const related = relatedTools(tool.slug);
const pageUrl = `https://sattiyans.com${tool.href}`;

const relatedPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && post.data.tool === tool.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: tool.name,
  description: tool.description,
  url: pageUrl,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Web Browser",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  featureList: tool.features,
  author: {
    "@type": "Person",
    name: "Sattiyan Selvarajah",
    url: "https://sattiyans.com",
  },
  isAccessibleForFree: true,
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: tool.faqs.map((faq: ToolFaq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://sattiyans.com/" },
    { "@type": "ListItem", position: 2, name: "Tools", item: "https://sattiyans.com/tools" },
    { "@type": "ListItem", position: 3, name: tool.shortName, item: pageUrl },
  ],
};
---

<PageLayout
  title={tool.name}
  description={tool.description}
  keywords={tool.keywords}
  image="/og-image.png"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <Container>
    <div class="space-y-10">
      <nav
        aria-label="Breadcrumb"
        class="flex items-center flex-wrap gap-x-2 gap-y-1 text-sm text-black/50 dark:text-white/50"
      >
        <Link href="/" underline={false} class="hover:text-black dark:hover:text-white transition-colors">Home</Link>
        <span aria-hidden="true">/</span>
        <Link href="/tools" underline={false} class="hover:text-black dark:hover:text-white transition-colors">Tools</Link>
        <span aria-hidden="true">/</span>
        <span class="text-black dark:text-white font-medium truncate">{tool.shortName}</span>
      </nav>

      <div class="grid gap-10 lg:grid-cols-[1fr_minmax(240px,300px)] lg:gap-14 items-start">
        <div class="min-w-0 space-y-8">
          <header class="space-y-3">
            <p class="text-xs font-medium uppercase tracking-wide text-black/45 dark:text-white/45">
              {tool.category} · Free · Client-side
            </p>
            <h1 class="text-2xl sm:text-3xl font-semibold text-black dark:text-white tracking-tight leading-tight">
              {tool.h1}
            </h1>
            <p class="text-sm sm:text-base text-black/65 dark:text-white/65 leading-relaxed max-w-2xl">
              {tool.summary}
            </p>
          </header>

          <section aria-label="Tool">
            <slot />
          </section>

          <section class="space-y-4 pt-2" aria-labelledby="how-heading">
            <h2 id="how-heading" class="text-lg font-semibold text-black dark:text-white">
              How this {tool.primaryKeyword} works
            </h2>
            <ol class="space-y-3">
              {
                tool.howItWorks.map((step, i) => (
                  <li class="flex gap-3 text-sm text-black/70 dark:text-white/70 leading-relaxed">
                    <span class="shrink-0 text-xs font-semibold text-black/35 dark:text-white/35 tabular-nums w-5">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span>{step}</span>
                  </li>
                ))
              }
            </ol>
          </section>

          <section class="space-y-4" aria-labelledby="faq-heading">
            <h2 id="faq-heading" class="text-lg font-semibold text-black dark:text-white">
              Frequently asked questions
            </h2>
            <div class="divide-y divide-black/10 dark:divide-white/10 border-t border-b border-black/10 dark:border-white/10">
              {
                tool.faqs.map((faq) => (
                  <details class="group py-4">
                    <summary class="cursor-pointer list-none flex items-start justify-between gap-3 text-sm font-medium text-black dark:text-white">
                      <span>{faq.question}</span>
                      <span class="text-black/35 dark:text-white/35 group-open:rotate-45 transition-transform text-lg leading-none">+</span>
                    </summary>
                    <p class="mt-2 text-sm text-black/60 dark:text-white/60 leading-relaxed pr-6">{faq.answer}</p>
                  </details>
                ))
              }
            </div>
          </section>
        </div>

        <aside class="lg:sticky lg:top-28 space-y-8">
          <div class="space-y-3">
            <p class="text-[11px] font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">
              Includes
            </p>
            <ul class="space-y-2.5">
              {
                tool.features.map((f) => (
                  <li class="text-sm text-black/70 dark:text-white/70 leading-snug pl-3 border-l-2 border-black/15 dark:border-white/15">
                    {f}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="space-y-2">
            <p class="text-[11px] font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">
              Privacy
            </p>
            <p class="text-sm text-black/60 dark:text-white/60 leading-relaxed">
              Runs entirely in your browser. Nothing is uploaded or stored on a server.
            </p>
          </div>

          {
            relatedPosts.length > 0 && (
              <div class="space-y-3">
                <p class="text-[11px] font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">
                  Related notes
                </p>
                <ul class="space-y-2">
                  {relatedPosts.map((post) => (
                    <li>
                      <Link
                        href={`/blog/${post.slug}`}
                        underline={false}
                        class="block text-sm font-medium text-black dark:text-white hover:opacity-70 transition-opacity"
                      >
                        {post.data.title}
                        <span class="block text-xs font-normal text-black/45 dark:text-white/45 mt-0.5 line-clamp-2">
                          {post.data.description}
                        </span>
                      </Link>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            related.length > 0 && (
              <div class="space-y-3">
                <p class="text-[11px] font-semibold tracking-wide uppercase text-black/45 dark:text-white/45">
                  More tools
                </p>
                <ul class="space-y-1">
                  {related.map((t) => (
                    <li>
                      <Link
                        href={t.href}
                        underline={false}
                        class="block py-2 text-sm font-medium text-black dark:text-white hover:opacity-70 transition-opacity"
                      >
                        {t.shortName}
                        <span class="block text-xs font-normal text-black/45 dark:text-white/45 mt-0.5">
                          {t.category}
                        </span>
                      </Link>
                    </li>
                  ))}
                </ul>
                <p class="text-xs text-black/40 dark:text-white/40 pt-1">
                  <Link href="/tools" underline={false} class="underline underline-offset-2 hover:text-black dark:hover:text-white">
                    All tools
                  </Link>
                </p>
              </div>
            )
          }
        </aside>
      </div>
    </div>
  </Container>
</PageLayout>
