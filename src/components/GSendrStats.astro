---
// Scale metrics for the GSendr case study — same card language as the
// Problem/Solution/Results blocks, just laid out as a stat strip.
const stats = [
  { value: "~10", label: "orgs live", border: "" },
  { value: "250K+", label: "WhatsApp sent · lifetime", border: "border-l border-black/10 dark:border-white/10" },
  {
    value: "10K+",
    label: "WhatsApp / day",
    border: "border-t border-black/10 dark:border-white/10 sm:border-t-0 sm:border-l",
  },
  {
    value: "10K+",
    label: "emails / day",
    border: "border-l border-t border-black/10 dark:border-white/10 sm:border-t-0",
  },
];
---

<div class="rounded-2xl border border-black/15 dark:border-white/15 grid grid-cols-2 sm:grid-cols-4 overflow-hidden">
  {
    stats.map((stat) => (
      <div class:list={["px-5 py-4 sm:px-4", stat.border]}>
        <p class="text-2xl font-bold tracking-tight text-black dark:text-white tabular-nums">{stat.value}</p>
        <p class="mt-1 text-[11px] font-medium uppercase tracking-wide text-black/45 dark:text-white/45">
          {stat.label}
        </p>
      </div>
    ))
  }
</div>
