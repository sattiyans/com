---
type Props = {
  rating: number;
  class?: string;
};

const { rating, class: className } = Astro.props;
const rounded = Math.round(rating);
---

<span class:list={["inline-flex items-center gap-0.5", className]} aria-label={`${rating} out of 5`}>
  {
    [1, 2, 3, 4, 5].map((n) => (
      <svg
        viewBox="0 0 20 20"
        class:list={[
          "size-3.5",
          n <= rounded ? "fill-amber-400" : "fill-black/10 dark:fill-white/15",
        ]}
        aria-hidden="true"
      >
        <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z" />
      </svg>
    ))
  }
</span>
